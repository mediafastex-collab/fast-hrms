{
  "name": "fast-hrms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "wrangler pages dev dist --d1 HRMS_DB=fast-hrms",
    "db:create": "wrangler d1 create fast-hrms",
    "db:migrate:local": "wrangler d1 migrations apply fast-hrms --local",
    "db:migrate": "wrangler d1 migrations apply fast-hrms --remote",
    "db:seed:local": "wrangler d1 execute fast-hrms --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute fast-hrms --remote --file=./seed.sql",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
